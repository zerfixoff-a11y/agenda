#!/usr/bin/env bash
# =====================================================================
#  creer-agenda.sh : crée le site d'agenda ET le publie sur GitHub Pages
#  Prérequis : git + GitHub CLI (gh), puis `gh auth login` une seule fois
#  Usage : bash creer-agenda.sh [nom-du-depot]
# =====================================================================
set -euo pipefail

REPO="${1:-mon-agenda}"

command -v gh  >/dev/null || { echo "Installez GitHub CLI : https://cli.github.com"; exit 1; }
command -v git >/dev/null || { echo "Installez git."; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "Connectez-vous d'abord : gh auth login"; exit 1; }

USER_GH="$(gh api user -q .login)"

mkdir -p "$REPO"
cd "$REPO"

# ---------- 1) Création du site ----------
cat > index.html <<'AGENDA_HTML_EOF'
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Mon agenda</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F3F6F8; --card:#FFFFFF; --ink:#1B2733; --muted:#5E6E7C; --line:#DCE3E9;
  --med:#C2415A; --perso:#1F7A8C; --travail:#B7791F; --accent:#1F7A8C;
  --onaccent:#fff; --medbg:#FBE9ED; --persobg:#E3F2F5; --travailbg:#FAF0DC;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#10181F; --card:#18232C; --ink:#E7EDF2; --muted:#9AAAB8; --line:#2A3A47;
    --med:#F08AA0; --perso:#6CC4D4; --travail:#E8B75E; --accent:#6CC4D4;
    --onaccent:#0b1419; --medbg:#3A1E27; --persobg:#173039; --travailbg:#3A2F17;
    color-scheme: dark;
  }
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 "Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif;
  padding:env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px)}
.wrap{max-width:1080px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:20px}
h1{font-size:1.9rem;margin:0;letter-spacing:-.01em}
h2{font-size:1.15rem;margin:0}
button,input,select,textarea{font:inherit;color:inherit}
.btn{border:1px solid var(--line);background:var(--card);padding:9px 14px;border-radius:8px;cursor:pointer;min-height:44px}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--onaccent);font-weight:700}
.btn.danger{color:var(--med)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.tools{display:flex;gap:8px;flex-wrap:wrap}
.layout{display:grid;gap:20px;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr)}
@media (max-width:820px){.layout{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.cal-head h2{text-transform:capitalize}
.nav{display:flex;gap:6px}
.nav .btn{padding:6px 12px;min-height:40px}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.dow{font-size:.8rem;color:var(--muted);text-align:center;padding-bottom:4px}
.day{aspect-ratio:1/1;border:1px solid transparent;border-radius:8px;background:transparent;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:5px 2px;gap:3px}
.day:hover{background:var(--bg)}
.day.out{color:var(--muted);opacity:.55}
.day.today{border-color:var(--accent);font-weight:700}
.day.sel{background:var(--accent);color:var(--onaccent)}
.dots{display:flex;gap:3px;flex-wrap:wrap;justify-content:center}
.dot{width:7px;height:7px;border-radius:50%;background:var(--perso)}
.dot.medical{background:var(--med)} .dot.travail{background:var(--travail)}
.day.sel .dot{box-shadow:0 0 0 1.5px #fff}
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;font-size:.9rem;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.filters{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 14px}
.chip{border:1px solid var(--line);background:transparent;border-radius:999px;padding:5px 12px;cursor:pointer;min-height:36px}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.list{display:flex;flex-direction:column;gap:10px;margin:0;padding:0;list-style:none}
.ev{border-left:5px solid var(--perso);background:var(--persobg);border-radius:8px;padding:10px 12px}
.ev.medical{border-color:var(--med);background:var(--medbg)}
.ev.travail{border-color:var(--travail);background:var(--travailbg)}
.ev .when{font-weight:700}
.ev .meta{color:var(--muted);font-size:.93rem}
.ev .notes{margin:6px 0 0;white-space:pre-wrap;font-size:.95rem}
.ev .row{display:flex;gap:8px;margin-top:8px}
.ev .row button{border:0;background:none;padding:2px 0;cursor:pointer;text-decoration:underline;color:var(--muted);min-height:32px}
.empty{color:var(--muted);padding:18px 4px}
.sub{color:var(--muted);font-size:.93rem;margin:2px 0 0}
dialog{border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--ink);padding:20px;width:min(460px,calc(100vw - 24px))}
dialog::backdrop{background:rgba(10,20,28,.5)}
form{display:grid;gap:12px}
label{display:grid;gap:4px;font-weight:700;font-size:.93rem}
input,select,textarea{border:1px solid var(--line);border-radius:8px;padding:9px 10px;background:var(--bg);font-weight:400;min-height:44px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:4px}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .2s}
.toast.show{opacity:1}
@media print{
  body{background:#fff;color:#000} .tools,.nav,.filters,.row,#calpanel{display:none!important}
  .layout{display:block} .panel{border:0;padding:0}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Mon agenda</h1>
    <div class="tools">
      <button class="btn primary" id="add">Ajouter un rendez-vous</button>
      <button class="btn" id="export">Sauvegarder</button>
      <button class="btn" id="import">Restaurer</button>
      <button class="btn" id="print">Imprimer</button>
      <input type="file" id="file" accept="application/json" hidden>
    </div>
  </header>

  <div class="layout">
    <section class="panel" id="calpanel" aria-label="Calendrier">
      <div class="cal-head">
        <h2 id="month"></h2>
        <div class="nav">
          <button class="btn" id="prev" aria-label="Mois précédent">‹</button>
          <button class="btn" id="today">Aujourd’hui</button>
          <button class="btn" id="next" aria-label="Mois suivant">›</button>
        </div>
      </div>
      <div class="grid" id="dows"></div>
      <div class="grid" id="days" role="grid"></div>
      <div class="legend">
        <span><i class="dot medical"></i>Médical</span>
        <span><i class="dot"></i>Personnel</span>
        <span><i class="dot travail"></i>Travail</span>
      </div>
    </section>

    <section class="panel" aria-label="Liste des rendez-vous">
      <h2 id="listTitle">À venir</h2>
      <p class="sub" id="listSub"></p>
      <div class="filters" id="filters" role="group" aria-label="Filtrer par catégorie"></div>
      <ul class="list" id="list"></ul>
    </section>
  </div>
  <p class="sub" style="margin-top:20px">Vos rendez-vous sont enregistrés uniquement dans ce navigateur. Pensez à utiliser « Sauvegarder » de temps en temps.</p>
</div>

<dialog id="dlg">
  <form id="form" method="dialog">
    <h2 id="dlgTitle">Nouveau rendez-vous</h2>
    <label>Titre
      <input id="f-title" required maxlength="120" placeholder="Ex. : Dentiste, Dr Martin">
    </label>
    <div class="two">
      <label>Date <input id="f-date" type="date" required></label>
      <label>Heure <input id="f-time" type="time"></label>
    </div>
    <label>Catégorie
      <select id="f-cat">
        <option value="medical">Médical</option>
        <option value="perso">Personnel</option>
        <option value="travail">Travail</option>
      </select>
    </label>
    <label>Lieu ou médecin <input id="f-place" maxlength="120" placeholder="Adresse, cabinet, téléphone…"></label>
    <label>Notes <textarea id="f-notes" rows="3" placeholder="Ordonnance à apporter, être à jeun…"></textarea></label>
    <div class="actions">
      <button type="button" class="btn danger" id="del" hidden>Supprimer</button>
      <button type="button" class="btn" id="cancel">Annuler</button>
      <button type="submit" class="btn primary">Enregistrer</button>
    </div>
  </form>
</dialog>
<div class="toast" id="toast" role="status"></div>

<script>
(function(){
  var KEY = "mon-agenda-v1";
  var CATS = {medical:"Médical", perso:"Personnel", travail:"Travail"};
  var events = load();
  var view = new Date(); view.setDate(1);
  var selected = null;       // "YYYY-MM-DD" ou null
  var filter = "all";
  var editingId = null;

  var $ = function(id){return document.getElementById(id)};

  function load(){
    try { var r = localStorage.getItem(KEY); return r ? JSON.parse(r) : []; }
    catch(e){ return []; }
  }
  function save(){
    try { localStorage.setItem(KEY, JSON.stringify(events)); }
    catch(e){ toast("Impossible d’enregistrer dans ce navigateur."); }
  }
  function pad(n){return String(n).padStart(2,"0")}
  function iso(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate())}
  function fmtDate(s){
    var p = s.split("-");
    return new Date(+p[0], +p[1]-1, +p[2]).toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric"});
  }
  function sortEv(a,b){ return (a.date+(a.time||"")).localeCompare(b.date+(b.time||"")); }
  function toast(msg){
    var t=$("toast"); t.textContent=msg; t.classList.add("show");
    setTimeout(function(){t.classList.remove("show")},2400);
  }
  function el(tag, cls, text){
    var e=document.createElement(tag);
    if(cls) e.className=cls;
    if(text!=null) e.textContent=text;
    return e;
  }

  /* Calendrier */
  function renderCal(){
    $("month").textContent = view.toLocaleDateString("fr-FR",{month:"long",year:"numeric"});
    var dows=$("dows"); dows.innerHTML="";
    ["lun","mar","mer","jeu","ven","sam","dim"].forEach(function(d){dows.appendChild(el("div","dow",d))});
    var box=$("days"); box.innerHTML="";
    var first=new Date(view.getFullYear(), view.getMonth(), 1);
    var offset=(first.getDay()+6)%7;
    var start=new Date(first); start.setDate(1-offset);
    var todayIso=iso(new Date());
    var byDate={};
    events.forEach(function(e){(byDate[e.date]=byDate[e.date]||[]).push(e)});
    for(var i=0;i<42;i++){
      var d=new Date(start); d.setDate(start.getDate()+i);
      var k=iso(d);
      var b=el("button","day");
      b.type="button";
      if(d.getMonth()!==view.getMonth()) b.classList.add("out");
      if(k===todayIso) b.classList.add("today");
      if(k===selected) b.classList.add("sel");
      b.appendChild(el("span",null,String(d.getDate())));
      var evs=byDate[k]||[];
      if(evs.length){
        var dots=el("span","dots");
        evs.slice(0,4).forEach(function(e){dots.appendChild(el("i","dot "+e.cat))});
        b.appendChild(dots);
      }
      b.setAttribute("aria-label", d.toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long"})+(evs.length?", "+evs.length+" rendez-vous":""));
      b.dataset.date=k;
      box.appendChild(b);
    }
  }

  /* Liste */
  function renderFilters(){
    var f=$("filters"); f.innerHTML="";
    [["all","Tout"],["medical","Médical"],["perso","Personnel"],["travail","Travail"]].forEach(function(c){
      var b=el("button","chip",c[1]); b.type="button";
      b.setAttribute("aria-pressed", String(filter===c[0]));
      b.onclick=function(){filter=c[0]; render();};
      f.appendChild(b);
    });
  }
  function renderList(){
    var todayIso=iso(new Date());
    var items=events.filter(function(e){return filter==="all"||e.cat===filter});
    if(selected){
      $("listTitle").textContent=fmtDate(selected);
      $("listSub").textContent="Cliquez à nouveau sur le jour pour revenir à la liste à venir.";
      items=items.filter(function(e){return e.date===selected});
    } else {
      $("listTitle").textContent="À venir";
      $("listSub").textContent="";
      items=items.filter(function(e){return e.date>=todayIso});
    }
    items.sort(sortEv);
    var ul=$("list"); ul.innerHTML="";
    if(!items.length){
      var li=el("li","empty", selected ? "Rien de prévu ce jour-là." : "Aucun rendez-vous à venir. Ajoutez-en un avec le bouton en haut.");
      ul.appendChild(li); return;
    }
    items.forEach(function(e){
      var li=el("li","ev "+e.cat);
      li.appendChild(el("div","when",(selected?"":fmtDate(e.date))+(e.time?(selected?"":" à ")+e.time:"")));
      li.appendChild(el("div",null,e.title));
      var meta=[CATS[e.cat]]; if(e.place) meta.push(e.place);
      li.appendChild(el("div","meta",meta.join(" – ")));
      if(e.notes) li.appendChild(el("p","notes",e.notes));
      var row=el("div","row");
      var edit=el("button",null,"Modifier"); edit.type="button"; edit.onclick=function(){openForm(e)};
      row.appendChild(edit); li.appendChild(row);
      ul.appendChild(li);
    });
  }
  function render(){ renderCal(); renderFilters(); renderList(); }

  /* Formulaire */
  function openForm(e, dateDefault){
    editingId = e ? e.id : null;
    $("dlgTitle").textContent = e ? "Modifier le rendez-vous" : "Nouveau rendez-vous";
    $("f-title").value = e ? e.title : "";
    $("f-date").value = e ? e.date : (dateDefault || selected || iso(new Date()));
    $("f-time").value = e ? (e.time||"") : "";
    $("f-cat").value = e ? e.cat : (filter!=="all"?filter:"medical");
    $("f-place").value = e ? (e.place||"") : "";
    $("f-notes").value = e ? (e.notes||"") : "";
    $("del").hidden = !e;
    $("dlg").showModal();
    $("f-title").focus();
  }
  $("form").addEventListener("submit", function(ev){
    ev.preventDefault();
    var data={
      title:$("f-title").value.trim(), date:$("f-date").value, time:$("f-time").value,
      cat:$("f-cat").value, place:$("f-place").value.trim(), notes:$("f-notes").value.trim()
    };
    if(!data.title||!data.date) return;
    if(editingId){
      events=events.map(function(e){return e.id===editingId?Object.assign({id:editingId},data):e});
    } else {
      data.id=Date.now().toString(36)+Math.random().toString(36).slice(2,6);
      events.push(data);
    }
    save(); $("dlg").close(); render(); toast("Rendez-vous enregistré.");
  });
  $("cancel").onclick=function(){$("dlg").close()};
  $("del").onclick=function(){
    if(!confirm("Supprimer ce rendez-vous ?")) return;
    events=events.filter(function(e){return e.id!==editingId});
    save(); $("dlg").close(); render(); toast("Rendez-vous supprimé.");
  };

  /* Navigation */
  $("days").addEventListener("click", function(ev){
    var b=ev.target.closest(".day"); if(!b) return;
    var k=b.dataset.date;
    selected = (selected===k) ? null : k;
    var d=k.split("-"); 
    if(+d[1]-1!==view.getMonth()){ view=new Date(+d[0], +d[1]-1, 1); }
    render();
  });
  $("days").addEventListener("dblclick", function(ev){
    var b=ev.target.closest(".day"); if(b) openForm(null, b.dataset.date);
  });
  $("prev").onclick=function(){view=new Date(view.getFullYear(),view.getMonth()-1,1);render()};
  $("next").onclick=function(){view=new Date(view.getFullYear(),view.getMonth()+1,1);render()};
  $("today").onclick=function(){var n=new Date();view=new Date(n.getFullYear(),n.getMonth(),1);selected=null;render()};
  $("add").onclick=function(){openForm(null)};
  $("print").onclick=function(){window.print()};

  /* Sauvegarde / restauration */
  $("export").onclick=function(){
    var blob=new Blob([JSON.stringify(events,null,2)],{type:"application/json"});
    var a=document.createElement("a");
    a.href=URL.createObjectURL(blob);
    a.download="agenda-"+iso(new Date())+".json";
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){URL.revokeObjectURL(a.href)},1000);
  };
  $("import").onclick=function(){$("file").click()};
  $("file").addEventListener("change", function(){
    var f=this.files[0]; if(!f) return;
    var r=new FileReader();
    r.onload=function(){
      try{
        var arr=JSON.parse(r.result);
        if(!Array.isArray(arr)) throw 0;
        if(!confirm("Remplacer l’agenda actuel par cette sauvegarde ("+arr.length+" rendez-vous) ?")) return;
        events=arr.filter(function(e){return e&&e.title&&e.date}).map(function(e){
          return {id:e.id||Date.now().toString(36)+Math.random().toString(36).slice(2,6),
                  title:String(e.title),date:String(e.date),time:String(e.time||""),
                  cat:CATS[e.cat]?e.cat:"perso",place:String(e.place||""),notes:String(e.notes||"")};
        });
        save(); render(); toast("Sauvegarde restaurée.");
      }catch(e){ toast("Fichier invalide."); }
    };
    r.readAsText(f); this.value="";
  });

  render();
})();
</script>
</body>
</html>
AGENDA_HTML_EOF

cat > README.md <<'README_EOF'
# Mon agenda
Site d'agenda (rendez-vous médicaux, perso, travail) hébergé avec GitHub Pages.
Les données restent dans le navigateur (localStorage), jamais sur GitHub.
Utilisez « Sauvegarder » / « Restaurer » pour changer d'appareil.
README_EOF

# ---------- 2) Dépôt GitHub ----------
[ -d .git ] || git init -b main >/dev/null
git add index.html README.md
git commit -m "Mon agenda" >/dev/null 2>&1 || true
gh repo create "$REPO" --public --source=. --remote=origin --push

# ---------- 3) Activation de GitHub Pages ----------
gh api -X POST "repos/$USER_GH/$REPO/pages" \
  -f "source[branch]=main" -f "source[path]=/" >/dev/null 2>&1 || \
gh api -X PUT "repos/$USER_GH/$REPO/pages" \
  -f "source[branch]=main" -f "source[path]=/" >/dev/null 2>&1 || true

echo
echo "Terminé ! Votre agenda sera en ligne dans 1 à 2 minutes :"
echo "  https://$USER_GH.github.io/$REPO/"
